{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "db:generate": {
      "outputs": ["prisma/client/**"]
    },
    "db:push": {
      "outputs": []
    },
    "db:studio": {
      "cache": false
    }
  },
  "globalEnv": ["DATABASE_URL", "JWT_SECRET", "GROQ_API_KEY", "HF_TOKEN"]
}