{
  "name": "rpg-story-life-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:rollback": "tsx scripts/rollback.ts",
    "seed": "tsx scripts/seed.ts",
    "db:tunnel": "railway connect Postgres --tunnel-only -P 15432",
    "db:push": "node scripts/db-push.js",
    "db:backup": "node scripts/db-backup.js",
    "db:pull": "node scripts/db-pull.js",
    "db:restore": "node scripts/db-restore.js",
    "db:exec": "node scripts/db-exec.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.0",
    "tsyringe": "^4.8.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.0",
    "eventemitter3": "^5.0.1",
    "tsx": "^4.19.1",
    "typeorm": "^0.3.20",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
